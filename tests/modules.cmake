cmake_minimum_required(VERSION 3.16)
find_program(GIT git)
if(NOT GIT)
  message(FATAL_ERROR "Git is required for module dependency tests")
endif()
string(RANDOM LENGTH 10 ALPHABET abcdef0123456789 nonce)
set(root "${WORK}/modules ${nonce}")
file(MAKE_DIRECTORY "${root}/app" "${root}/math/src" "${root}/base/src")
function(command cwd expected)
  execute_process(COMMAND "${COMPILER}" ${ARGN} WORKING_DIRECTORY "${cwd}" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  if(NOT status EQUAL expected)
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${status}\n${out}\n${err}")
  endif()
  string(REPLACE "\r\n" "\n" out "${out}")
  set(output "${out}" PARENT_SCOPE)
endfunction()
function(git cwd)
  execute_process(COMMAND "${GIT}" -C "${cwd}" ${ARGN} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "git ${ARGN}: ${out}\n${err}")
  endif()
endfunction()
function(commit cwd)
  git("${cwd}" add .)
  git("${cwd}" -c user.name=Axiom -c user.email=axiom@example.invalid -c commit.gpgsign=false commit -qm fixture)
endfunction()
file(WRITE "${root}/app/keep.txt" "preserve me")
command("${root}/app" 0 mod init demo)
if(EXISTS "${root}/app/src" OR NOT EXISTS "${root}/app/Axiom.toml")
  message(FATAL_ERROR "mod init must only create the manifest")
endif()
file(READ "${root}/app/Axiom.toml" initial_manifest)
command("${root}/app" 1 mod init other)
file(READ "${root}/app/Axiom.toml" unchanged_manifest)
if(NOT initial_manifest STREQUAL unchanged_manifest)
  message(FATAL_ERROR "mod init overwrote existing manifest")
endif()
file(WRITE "${root}/base/src/lib.ax" "pub def base_value := 40;")
git("${root}/base" init -q)
commit("${root}/base")
file(WRITE "${root}/math/src/lib.ax" "import base; pub def answer := base.base_value()+2;")
file(WRITE "${root}/math/src/extra.ax" "pub def extra := 7;")
command("${root}/math" 0 mod init math)
command("${root}/math" 0 get "${root}/base")
file(WRITE "${root}/math/.gitignore" ".axiom/\n")
git("${root}/math" init -q)
commit("${root}/math")
git("${root}/math" tag v1)
command("${root}/app" 0 get "${root}/math@v1" --name numbers)
file(READ "${root}/app/Axiom.toml" pinned_manifest)
if(NOT pinned_manifest MATCHES "numbers = .*#[0-9a-f]+")
  message(FATAL_ERROR "dependency was not pinned to a commit")
endif()
file(WRITE "${root}/app/src/main.ax" "import numbers; import numbers.extra; def main := { println(numbers.answer()); println(extra.extra()); };")
file(WRITE "${root}/app/src/base.ax" "pub def base_value := 900;")
command("${root}/app" 0 run)
if(NOT output STREQUAL "42\n7\n")
  message(FATAL_ERROR "direct/transitive/submodule imports failed: ${output}")
endif()
# A changed upstream default branch must not change the pinned build.
file(WRITE "${root}/math/src/lib.ax" "pub def answer := 99;")
commit("${root}/math")
file(REMOVE_RECURSE "${root}/app/.axiom")
command("${root}/app" 1 check)
command("${root}/app" 0 get)
command("${root}/app" 0 run)
if(NOT output STREQUAL "42\n7\n")
  message(FATAL_ERROR "restore did not honor pinned revisions")
endif()
command("${root}/app" 1 get "${root}/math" --rev nonexistent)
command("${root}/app" 1 get "${root}/math" --name ../escape)
command("${root}/app" 1 get "${root}/math" --name std)
file(READ "${root}/app/Axiom.toml" after_failure)
if(NOT pinned_manifest STREQUAL after_failure)
  message(FATAL_ERROR "failed get changed manifest")
endif()
# Replacing an existing dependency preserves surrounding TOML sections.
file(APPEND "${root}/app/Axiom.toml" "\n[cpp]\nlibraries = []\n")
command("${root}/app/src" 0 get "${root}/math" --name numbers)
command("${root}/app" 0 run)
if(NOT output STREQUAL "99\n7\n")
  message(FATAL_ERROR "dependency update failed")
endif()
command("${root}/app" 0 get)

# Existing root-level source is detected without rewriting it.
file(MAKE_DIRECTORY "${root}/existing")
file(WRITE "${root}/existing/main.ax" "def main := println(7);")
command("${root}/existing" 0 mod init)
command("${root}/existing" 0 run)
if(NOT output STREQUAL "7\n")
  message(FATAL_ERROR "mod init failed to preserve/detect main.ax")
endif()
