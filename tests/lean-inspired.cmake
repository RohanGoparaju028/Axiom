cmake_minimum_required(VERSION 3.16)
string(RANDOM LENGTH 10 ALPHABET abcdef0123456789 nonce)
set(root "${WORK}/run ${nonce}")
file(MAKE_DIRECTORY "${root}")
if(WIN32)
  set(suffix .exe)
endif()
function(command cwd expected)
  execute_process(COMMAND "${COMPILER}" ${ARGN} WORKING_DIRECTORY "${cwd}"
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 60)
  if(NOT status EQUAL expected)
    message(FATAL_ERROR "${ARGN}: expected ${expected}, got ${status}\n${out}\n${err}")
  endif()
  string(REPLACE "\r\n" "\n" out "${out}")
  set(output "${out}" PARENT_SCOPE)
  set(diagnostic "${err}" PARENT_SCOPE)
endfunction()
function(program name source expected)
  file(WRITE "${root}/${name}.ax" "${source}")
  command("${root}" 0 run "${name}.ax")
  if(NOT output STREQUAL expected)
    message(FATAL_ERROR "${name}: expected [${expected}], got [${output}]")
  endif()
endfunction()
function(reject name source reason)
  file(WRITE "${root}/${name}.ax" "${source}")
  command("${root}" 1 check "${name}.ax")
  if(NOT diagnostic MATCHES "${reason}")
    message(FATAL_ERROR "${name}: expected diagnostic ${reason}, got ${diagnostic}")
  endif()
endfunction()
function(runtime_failure name source reason)
  file(WRITE "${root}/${name}.ax" "${source}")
  command("${root}" 1 run "${name}.ax")
  if(NOT diagnostic MATCHES "Axiom runtime error:.*${reason}")
    message(FATAL_ERROR "${name}: wrong runtime diagnostic ${diagnostic}")
  endif()
endfunction()

# Lean-inspired definitions share the existing checker and runtime.
file(READ "${SOURCE}/examples/lean.ax" lean_example)
program(lean_example "${lean_example}" "answer: 42\n120\n10\n")
program(lean_binders "def sum (a b:i32) (c:i32) := a+b+c; def main := { let f := fun (a b:i32) => a+b; println(sum(1,2,3)); println(f(4,5)); };" "6\n9\n")
program(lean_mutual "def even (n:i32):bool := if n==0 then true else odd(n-1); def odd (n:i32):bool := if n==0 then false else even(n-1); def main := println(even(6));" "true\n")
reject(lean_immutable "def main := { let x := 1; x = 2; };" "immutable")
reject(lean_immutable_array "def main := { let xs := Array<i32>(); xs.push(1); };" "immutable")
reject(lean_recursive_inference "def loop (n:i32) := loop(n); def main := loop(0);" "explicit result type")
reject(lean_empty_inductive "inductive Empty where;" "expected")
reject(lean_duplicate_variant "inductive Choice where | A | A;" "duplicate variant")
reject(lean_missing_arm "inductive Choice where | A | B; def choose (x:Choice) := match x with | Choice::A => 1;" "exhaustive|cover|missing")
reject(lean_duplicate_binder "def f (x x:i32) := x;" "duplicate")
reject(lean_missing_definition "def main = 0;" "expected ':='")

# Direct def bodies infer unit or the final expression, just like expression bodies.
program(direct_main "def main { println(42); }" "42\n")
program(direct_def_values "def add (a b:i32) { a+b } def main() { println(add(20,22)); }" "42\n")
program(direct_def_annotation "def positive (n:i32):i32 { if n>0 { return n; } return 0; } def main : i32 { println(positive(42)); return 0; }" "42\n")
program(direct_def_conditional "def answer (flag:bool) { if flag { 42 } else { 0 } } def main { println(answer(true)); }" "42\n")
program(direct_main_empty "def main {}" "")
file(WRITE "${root}/direct_exit.ax" "def main { 7 }")
command("${root}" 7 run direct_exit.ax)
reject(direct_main_wrong_result "def main { true }" "entry must be")
reject(direct_recursive_annotation "def loop (n:i32) { loop(n) } def main { loop(0) }" "explicit result type")
