{
  "name": "axiom-language",
  "displayName": "Axiom",
  "description": "Axiom syntax, project and file runners, checks, and native debugging through CodeLLDB.",
  "version": "0.1.0",
  "publisher": "axiom-local",
  "engines": {"vscode": "^1.85.0"},
  "categories": ["Programming Languages", "Debuggers"],
  "license": "Apache-2.0",
  "main": "./extension.js",
  "activationEvents": ["onLanguage:axiom", "onCommand:axiom.runFile", "onCommand:axiom.debugFile", "onCommand:axiom.runProject", "onCommand:axiom.debugProject", "onDebugResolve:lldb"],
  "extensionPack": ["vadimcn.vscode-lldb"],
  "capabilities": {"untrustedWorkspaces": {"supported": "limited", "description": "Syntax highlighting is available; checks, builds, running and debugging require workspace trust."}},
  "contributes": {
    "languages": [{"id": "axiom", "aliases": ["Axiom", "axiom"], "extensions": [".ax", ".ar", ".fe"], "configuration": "./language-configuration.json"}],
    "grammars": [{"language": "axiom", "scopeName": "source.axiom", "path": "./syntaxes/axiom.tmLanguage.json"}],
    "breakpoints": [{"language": "axiom"}],
    "problemMatchers": [{"name": "axiom", "owner": "axiom", "fileLocation": "absolute", "severity": "error", "pattern": {"regexp": "^axiomc: (.*):(\\d+):(\\d+): (.*)$", "file": 1, "line": 2, "column": 3, "message": 4}}],
    "commands": [
      {"command": "axiom.runFile", "title": "Axiom: Run File", "icon": "$(play)"},
      {"command": "axiom.debugFile", "title": "Axiom: Debug File", "icon": "$(debug-alt)"},
      {"command": "axiom.checkFile", "title": "Axiom: Check File"},
      {"command": "axiom.runProject", "title": "Axiom: Run Project"},
      {"command": "axiom.debugProject", "title": "Axiom: Debug Project"},
      {"command": "axiom.buildProject", "title": "Axiom: Build Project"}
    ],
    "menus": {"editor/title": [
      {"command": "axiom.runFile", "when": "editorLangId == axiom && isWorkspaceTrusted", "group": "navigation"},
      {"command": "axiom.debugFile", "when": "editorLangId == axiom && isWorkspaceTrusted", "group": "navigation"}
    ]},
    "configuration": {"title": "Axiom", "properties": {
      "axiom.compilerPath": {"type": "string", "default": "", "description": "One axiomc executable path. Otherwise search the workspace build directory, then PATH.", "scope": "resource"},
      "axiom.debugArgs": {"type": "array", "items": {"type": "string"}, "default": [], "description": "Arguments passed to the debugged executable.", "scope": "resource"}
    }},
    "keybindings": [{"command": "axiom.debugFile", "key": "f5", "when": "editorLangId == axiom && !inDebugMode && isWorkspaceTrusted"}]
  },
  "scripts": {"test": "node --test test/*.test.js", "package": "node scripts/package.js"}
}
